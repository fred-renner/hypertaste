# Agent-plane image for the self-modifying meta agent (hta/sandbox.py: DockerSandbox).
# Minimal on purpose: Node + the Claude Code CLI and nothing else. No project code, no
# .env, no world source -- the child workspace is copied to /workspace at run time and
# the edited result copied back out.
FROM node:22-slim

# Claude Code CLI (the agent runtime).
RUN npm install -g @anthropic-ai/claude-code \
    && npm cache clean --force

# Non-root user with a writable HOME for claude's config/cache (part of the boundary,
# alongside --cap-drop ALL / --security-opt no-new-privileges set at run time).
RUN useradd --create-home --shell /usr/sbin/nologin agent \
    && mkdir -p /workspace \
    && chown -R agent:agent /workspace /home/agent
USER agent
ENV HOME=/home/agent
WORKDIR /workspace

# No ENTRYPOINT: the orchestrator passes the full `claude -p ...` argv at run time
# (airgap flags live in hta/llm.agentic_argv). Default CMD is a build-time smoke check.
CMD ["claude", "--version"]
